{
  "version": 2,
  "builds": [
    {
      "src": "reverse-ai-studio/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/import-video.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/((?!api/).*)", "dest": "/index.html" }
  ]
}
