# Root-level environment variables for docker-compose

# PostgreSQL
POSTGRES_DB=reverse_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
APP_NAME=Reverse AI Studio
APP_VERSION=1.0.0
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/reverse_ai
REDIS_URL=redis://redis:6379/0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=reverse-ai-storage
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
